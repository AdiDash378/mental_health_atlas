# Virtual environments
.venv/
venv/
env/
ENV/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class

# Dynamically generated charts (Matplotlib outputs from app.py)
charts/*.png
!charts/.gitkeep

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDE and Editor configurations
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Operating System files
Thumbs.db
Desktop.ini
.DS_Store

# Accidental folder created from bash brace expansion on Windows
{data,templates,static/
